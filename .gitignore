# ============================================
# 银铃 Yinling · .gitignore
# ============================================

# ---------- 1. 密钥与本地配置 ----------
.env
.env.local
.env.*
!.env.example
project.private.config.json
miniprogram/project.private.config.json
*.pem
*.key
*.p12

# ---------- 2. 依赖与构建产物 ----------
node_modules/
miniprogram_npm/
dist/
build/
coverage/
*.log
npm-debug.log*

# ---------- 3. 调研数据（红线：绝不入库）----------
*.xlsx
*.xls
*.csv
docs/问卷数据/
docs/挑战杯申报/
docs/基线文档/

# ---------- 4. 上传文件 ----------
uploads/
!uploads/.gitkeep

# ---------- 5. Office / WPS 临时文件 ----------
~$*
*.tmp
*.bak

# ---------- 6. 编辑器与系统 ----------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
