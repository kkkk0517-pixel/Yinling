# ---- 服务 ----
NODE_ENV=development
PORT=3000

# ---- 自动调度（默认随服务启动） ----
JOBS_ENABLED=true
JOB_POLL_MS=250
JOB_RETRY_MS=30000
JOB_T2_INTERVAL_SEC=30
JOB_T3_HOUR=3
JOB_T4_INTERVAL_MIN=60
# T1 的统计日切点来自 param.day_cut_hour，默认 UTC+8 04:00。
# 开发清库前设 JOBS_ENABLED=false 并重启；频率按业务时钟，退避/健康按真实时间。

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yinling
DB_POOL=10

# ---- 鉴权 ----
# 部署前必须换成随机串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_in_local
JWT_EXPIRES=7d

# ---- 开发便利 ----
# 开发环境短信验证码固定值，不发真短信
DEV_SMS_CODE=123456

# ---- 上传 ----
UPLOAD_DIR=../uploads
