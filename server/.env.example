# ---- 服务 ----
NODE_ENV=development
PORT=3000

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yinling
DB_POOL=10

# ---- 鉴权 ----
# 部署前必须换成随机串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_in_local
JWT_EXPIRES=7d

# ---- 开发便利 ----
# 开发环境短信验证码固定值，不发真短信
DEV_SMS_CODE=123456

# ---- 上传 ----
UPLOAD_DIR=../uploads
